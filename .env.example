# Spotify API credentials (from https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=

# The Spotify playlist to update (from playlist URL, e.g. https://open.spotify.com/playlist/37i9dQZF1...)
SPOTIFY_PLAYLIST_ID=

# YouTube Data API key (from https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# The YouTube playlist to watch (from playlist URL, e.g. https://www.youtube.com/playlist?list=PL...)
YOUTUBE_PLAYLIST_ID=
